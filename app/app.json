{
  "expo": {
    "name": "Liftmason",
    "slug": "best-gym-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "liftmason",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.liftmason.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F4FD8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.liftmason.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F4FD8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "cameraPermission": "$(PRODUCT_NAME) uses the camera to record form videos for your coach.",
          "microphonePermission": "Form videos are recorded with sound.",
          "photosPermission": "Choose a form video from your library for your coach."
        }
      ],
      "expo-video",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "spearws-team",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "643c544f-ee0c-4f91-a951-0cd2511ce166"
      }
    }
  }
}
