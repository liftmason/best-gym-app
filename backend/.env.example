# Copy to .env for local overrides; `make` loads it. Every variable the backend reads is listed
# here (a test checks this). Local defaults work without a .env once `make db` is running.

DJANGO_SETTINGS_MODULE=config.settings.local
DATABASE_URL=postgres://gymtrainer:gymtrainer@localhost:5432/gymtrainer
SECRET_KEY=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
# Links in emails sent by the cron job (digests), e.g. https://gymtrainer.onrender.com.
# Required in production (Render sets RENDER_EXTERNAL_URL, which is used if this is blank).
SITE_URL=
# The product's name in emails and the API (a placeholder; blank means GymTrainer).
APP_NAME=

# Email. EMAIL_PROVIDER is resend or postmark (with EMAIL_API_KEY), or console to print email.
# Production refuses to start without it, and with a real provider needs DEFAULT_FROM_EMAIL.
EMAIL_PROVIDER=
EMAIL_API_KEY=
DEFAULT_FROM_EMAIL=

# Push notifications. PUSH_PROVIDER is expo, or console (or blank) to log them. Production
# refuses to start without it. EXPO_ACCESS_TOKEN only if the Expo project turns on
# "enhanced push security".
PUSH_PROVIDER=
EXPO_ACCESS_TOKEN=

# Form-video storage (S3-compatible: Cloudflare R2 in production, MinIO locally).
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET=
STORAGE_REGION=

# The Django admin: its address, and the account created at start-up by `manage.py ensure_admin`.
ADMIN_PATH=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# seed_demo's password for new demo users (required in production settings).
DEMO_PASSWORD=

# Temporary: log the client-address headers of rate-limited requests (audit M24).
LOG_CLIENT_IP=

# Set by Render itself; listed so nothing is missing. Don't set them locally.
RENDER_EXTERNAL_HOSTNAME=
RENDER_EXTERNAL_URL=

# Error reporting to Sentry (production only); blank leaves it off.
SENTRY_DSN=

# A fixed sign-in code for the App Store / Play review account only (six digits); blank: none.
REVIEW_ACCOUNT_EMAIL=
REVIEW_ACCOUNT_CODE=

# The web app's origin(s), comma-separated, e.g. https://app.example.com (CORS for /api/).
WEB_APP_ORIGINS=

# Sign in with Apple / Google: the client ids tokens are issued to, comma-separated; blank: off.
APPLE_CLIENT_IDS=
GOOGLE_CLIENT_IDS=

# Billing: 1 turns it on (off: everything allowed). DEFAULT_PLAN: the plan code new gyms get.
BILLING_ENABLED=
DEFAULT_PLAN=
# Stripe (test mode keys in development; the CLI forwards webhooks locally).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
