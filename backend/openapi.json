  "info": {
    "description": "",
    "title": "GymTrainer API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/devices": {
      "get": {
        "operationId": "apps_signin_api_devices",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DeviceOut"
                  },
                  "title": "Response",
                  "type": "array"
                }
              }
            },
            "description": "OK"
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ],
        "summary": "Devices",
        "tags": [
          "Sign-in"
        ]
      }
    },
    "/api/v1/auth/devices/{device_id}/signout": {
      "post": {
        "operationId": "apps_signin_api_sign_out_device",
        "parameters": [
          {
            "in": "path",
            "name": "device_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Device Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ],
        "summary": "Sign Out Device",
        "tags": [
          "Sign-in"
        ]
      }
    },
    "/api/v1/auth/email/start": {
      "post": {
        "description": "Email a sign-in code. The same answer whether or not the email has an account.",
        "operationId": "apps_signin_api_email_start",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted"
          }
        },
        "summary": "Email Start",
        "tags": [
          "Sign-in"
        ]
      }
    },
    "/api/v1/auth/email/verify": {
      "post": {
        "description": "Check the code: sign in to the email's account, or, for a new email, return a sign-up\nticket (valid 30 minutes) for coach sign-up or joining through an invite.",
        "operationId": "apps_signin_api_email_verify",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyOut"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Email Verify",
        "tags": [
          "Sign-in"
        ]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "description": "New tokens for a refresh token (from the body, or the web app's cookie).",
        "operationId": "apps_signin_api_refresh",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokensOut"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Refresh",
        "tags": [
          "Sign-in"
        ]
      }
    },
    "/api/v1/auth/signout": {
      "post": {
        "operationId": "apps_signin_api_sign_out",
        "parameters": [],
        "responses": {
          "204": {
            "description": "No Content"
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ],
        "summary": "Sign Out",
        "tags": [
          "Sign-in"
        ]
      }
    },
    "/api/v1/auth/signup/coach": {
      "post": {
        "description": "A new coach and their gym, for an email verified by `email/verify`.",
        "operationId": "apps_signin_api_coach_sign_up",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CoachSignUpIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokensOut"
                }
              }
            },
            "description": "Created"
          }
        },
        "summary": "Coach Sign Up",
        "tags": [
          "Sign-in"
        ]
      }
    },
    "/api/v1/invites/{token}": {
      "get": {
        "description": "What an invite link is for, before joining.",
        "operationId": "apps_accounts_api_invite",
        "parameters": [
          {
            "in": "path",
            "name": "token",
            "required": true,
            "schema": {
              "title": "Token",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InviteOut"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Invite",
        "tags": [
          "Invites"
        ]
      }
    },
    "/api/v1/invites/{token}/accept": {
      "post": {
        "description": "Join as the signed-in account (an athlete without a coach, or a new athlete profile).",
        "operationId": "apps_accounts_api_accept_invite",
        "parameters": [
          {
            "in": "path",
            "name": "token",
            "required": true,
            "schema": {
              "title": "Token",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JoinedOut"
                }
              }
            },
            "description": "OK"
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ],
        "summary": "Accept Invite",
        "tags": [
          "Invites"
        ]
      }
    },
    "/api/v1/invites/{token}/signup": {
      "post": {
        "description": "Join as a new account, for an email verified by `auth/email/verify` (its ticket).\nAnswers with the new account's tokens, like signing in.",
        "operationId": "apps_accounts_api_join_new",
        "parameters": [
          {
            "in": "path",
            "name": "token",
            "required": true,
            "schema": {
              "title": "Token",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JoinNewIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created"
          }
        },
        "summary": "Join New",
        "tags": [
          "Invites"
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "description": "The signed-in person and their profiles: a coach (with their gym), an athlete (with\ntheir coach), or both. An athlete without a coach has `coach_name` null.",
        "operationId": "apps_accounts_api_me",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            },
            "description": "OK"
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ],
        "summary": "Me",
        "tags": [
          "Account"
        ]
      }
    }
  },
  "servers": []
}
