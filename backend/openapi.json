            "Bearer": []
          }
        ],
        "summary": "Devices",
        "tags": [
          "Sign-in"
        ]
      }
    },
    "/api/v1/auth/devices/{device_id}/signout": {
      "post": {
        "operationId": "apps_signin_api_sign_out_device",
        "parameters": [
          {
            "in": "path",
            "name": "device_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Device Id",
              "type": "string"
            }
          }
        ],
